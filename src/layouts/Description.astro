---
import DescriptionNav from "./components/DescriptionNav.astro";
import Layout from "./Layout.astro";
const { title } = Astro.props;
---

<Layout>
  <main class="DescriptionClient">
    <h1 class="DescriptionClient__title">{title}</h1>
    <slot />
  </main>
  <DescriptionNav />
  <style>
    .DescriptionClient {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2em;
    }
    .DescriptionClient__title {
      font-size: 2em;
      text-transform: capitalize;
    }
  </style>
</Layout>
